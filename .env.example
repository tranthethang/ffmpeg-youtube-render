# --- Hardware & Paths ---
FFMPEG_PATH=ffmpeg
ASSETS_DIR=./assets
INPUT_DIR=./input
OUTPUT_DIR=./output

# --- Video Settings ---
# Hỗ trợ: 720p (1280x720), 480p (854x480), 360p (640x360)
VIDEO_QUALITY=480p
VIDEO_BITRATE=1.5M
VIDEO_CODEC=hevc_nvenc
SELECTED_SAMPLE=sample-01.m4v

# --- Layer Order (Z-index) ---
# Số nhỏ nằm dưới, số lớn nằm trên
LAYER_VIDEO_ORDER=1
LAYER_OVERLAY_ORDER=2
LAYER_COVER_ORDER=3

# --- Audio Settings ---
AUDIO_TRIM_START=00:01:10
AUDIO_TRIM_END=
AUDIO_BITRATE=128k

# --- Text/Font Settings ---
FONT_FILE=./assets/fonts/Pacifico-Regular.ttf
FONT_SIZE=60
TEXT_COLOR=255,255,255,255
TEXT_POSITION_X=50
TEXT_POSITION_Y=400
